# 路径相对仓库根目录解析
CODEPOET_DATA_DIR=data

# 启用的渲染后端，逗号分隔。默认只有 canvas2d。
#
# 演示 / 验收环境必须显式打开已经通过真实渲染验收的后端，否则页面上
# CSS、WebGL 的入口是灰的——看起来像没做完，其实只是没配。
#
#     CODEPOET_ENABLED_BACKENDS=canvas2d,css,webgl
#
# 只写名字不够：后端注册表（app/engine/capabilities.py）里没有渲染器版本的
# 后端即使写进来也只会声明 available=false，不会静默回落到 Canvas。
# turtle 要等 R3（server 执行模式），本期写进来也不会可用。
# CODEPOET_ENABLED_BACKENDS=canvas2d

# K1 外部知识图谱来源白名单，逗号分隔的 sourceId（目前只有 wikidata）。
#
# 留空 = 未配置，features.knowledgeGraph 为 false，界面不显示来源入口，
# POST /knowledge-graph/generations 一律 503。代码已经就绪，开这一项即启用。
# 只认这里的键，不接受用户传 URL——否则服务端就成了任意地址代理。
# 启用 K1 前请确认已执行 `uv run --project backend python scripts/seed_demo.py`
# 导入站内知识与映射规则，并配置下方显式映射表。
# CODEPOET_KNOWLEDGE_GRAPH_SOURCES=wikidata

# K1 外部实体 → 站内知识条目的显式映射表（JSON，相对仓库根目录解析）。
# Wikidata 的「竹（Q670887）」中文标签为「竹亚科」、站内为「竹」；「梅（Q157763）」
# 站内为「墨梅」，需通过显式映射表对齐，否则会返回 422 NO_SEMANTIC_MATCH。
# CODEPOET_KNOWLEDGE_GRAPH_MAPPING_FILE=shared/demo/knowledge-graph-mappings.json

# 抓取超时（秒）。Wikidata 单次实测 3~6s，留一倍余量。
# CODEPOET_KNOWLEDGE_GRAPH_TIMEOUT_SECONDS=10

# 生产环境走 HTTPS 时必须设为 true，否则会话 Cookie 会在明文连接上传输。
# 本地 http 开发保持 false。
# CODEPOET_COOKIE_SECURE=false

# X1 智能辅助可视计算能力（OpenAI 兼容接口，默认 DeepSeek）。
# CODEPOET_LLM_API_KEY 留空时 features.llmAssistant 保持 false，
# POST /api/v1/assistant/proposals 返回 503 ASSISTANT_UNAVAILABLE。
# 严禁将真实密钥提交到仓库。
# CODEPOET_LLM_BASE_URL=https://api.deepseek.com
# CODEPOET_LLM_API_KEY=
# CODEPOET_LLM_MODEL=deepseek-chat
# CODEPOET_LLM_TIMEOUT_SECONDS=30
